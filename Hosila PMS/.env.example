# GEMINI_API_KEY: Optional AI Studio environment secret.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional Resend API key for automated outgoing guest confirmation emails
# (reservation confirmation, check-in welcome, check-out receipt).
# Core hotel operations, SQLite storage, and LAN synchronization run completely offline without this key.
RESEND_API_KEY=

# RESEND_FROM_EMAIL: Verified sender address in Resend (e.g. "Grand Hotel <reservations@yourdomain.com>").
# Defaults to "Hosila PMS <onboarding@resend.dev>" if unset.
RESEND_FROM_EMAIL=

# HOSILA_DATA_DIR: Optional override for SQLite database, backups, and logs directory.
# Defaults to ./data (use e.g. C:\ProgramData\Hosila PMS\data for Windows installer deployments).
HOSILA_DATA_DIR=

# HOSILA_BACKUP_MIRROR_DIR: Optional secondary off-PC backup folder (e.g. USB drive E:\HosilaBackups or LAN share).
HOSILA_BACKUP_MIRROR_DIR=
