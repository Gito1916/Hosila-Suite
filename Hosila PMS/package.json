{
  "name": "hosila-pms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist-server/server.mjs",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "build:exe": "powershell -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "build:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/verify-production.ts",
    "license:gen": "tsx scripts/generate-license.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.0",
    "resend": "^6.39.0",
    "vite": "^8.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}