{
  "name": "hosila-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./server/server.mjs",
    "dev": "node ./server/server.mjs",
    "sync": "node ./scripts/sync-site.mjs",
    "build:docs": "npx astro build --root ./docs-starlight && node ./scripts/copy-docs.mjs",
    "build": "npm run build:docs && npm run sync",
    "mockups:update": "node ./scripts/capture-mockups.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.34.0",
    "astro": "^5.7.0",
    "gsap": "^3.12.7",
    "sharp": "^0.34.1",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0"
  }
}
