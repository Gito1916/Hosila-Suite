{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/(fonts|vendor|mockups|_astro)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/activate", "destination": "/contact", "permanent": true },
    { "source": "/activate/", "destination": "/contact", "permanent": true },
    { "source": "/sitemap-index.xml", "destination": "/sitemap.xml", "permanent": true },
    {
      "source": "/api/download/hosila-pms",
      "destination": "https://sd6k88hbtarxlrqt.public.blob.vercel-storage.com/hosila-pms/1.0.0/Hosila-PMS-Setup.exe?download=1",
      "permanent": false
    },
    {
      "source": "/api/download/hosila-ims",
      "destination": "https://sd6k88hbtarxlrqt.public.blob.vercel-storage.com/hosila-ims/1.0.0/Hosila-IMS-Setup.exe?download=1",
      "permanent": false
    }
  ]
}
