# Server-side Ed25519 signing key (NEVER expose to client code or public/)
HOSILA_MASTER_PRIVATE_PEM=

# Payment gateways (leave blank in local dev to use Instant Sandbox Order mode)
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional CDN base URL for production installer downloads (e.g. Cloudflare R2)
PUBLIC_RELEASES_CDN_URL=

# Server port
PORT=4321

